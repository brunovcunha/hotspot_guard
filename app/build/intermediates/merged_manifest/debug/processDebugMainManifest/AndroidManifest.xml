<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="br.com.grupobomjesus.hotspotguard"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="Hotspot Guard"
        android:theme="@style/AppTheme" >
        <activity
            android:name="br.com.grupobomjesus.hotspotguard.LockActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name="br.com.grupobomjesus.hotspotguard.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="br.com.grupobomjesus.hotspotguard.SettingsGuardService"
            android:exported="true"
            android:label="Hotspot Guard - proteção das Configurações"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>